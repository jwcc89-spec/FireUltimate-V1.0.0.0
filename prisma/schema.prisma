generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String               @id @default(cuid())
  slug               String               @unique
  name               String
  status             String               @default("active")
  nerisEntityId      String?
  /// Fire Recovery USA Recovery Hub subscription key (non-secret identifier; store API password in env).
  fireRecoverySubscriptionKey   String?
  /// Department display name sent to Fire Recovery incident billing API.
  fireRecoveryDepartmentName    String?
  /// Optional per-tenant Fire Recovery API login (JWT). If both username and password are set, server uses them instead of FIRE_RECOVERY_API_* env.
  fireRecoveryApiUsername       String?
  fireRecoveryApiPassword       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  domains            TenantDomain[]
  users              User[]
  departments        DepartmentDetails[]
  incidents          Incident[]
  cadEmails               CadEmailIngest[]
  cadParsingSettings      CadParsingSettings?
  cadEmailAllowlist       CadEmailAllowlistEntry[]
  nerisExportHistory      NerisExportHistory[]
  nerisDrafts             NerisDraft[]
  nerisReportChanges      NerisReportChange[]
  fireRecoveryIncidentBillings FireRecoveryIncidentBilling[]
  sessions                    Session[]
  rolePermissions             RolePermission[]
  accountAuditLogs            AccountAuditLog[]
  tradeRequests               TradeRequest[]
  qualificationOverrideRequests QualificationOverrideRequest[]
  comments                    Comment[]
  maintenanceRecords          MaintenanceRecord[]
  maintenanceTypes            MaintenanceType[]
  vendors                     Vendor[]
  maintenanceCosts            MaintenanceCost[]
  pmSchedules                 PmSchedule[]
  equipment                   Equipment[]
  parts                       Part[]
  partTransactions            PartTransaction[]
  checklistTemplates          ChecklistTemplate[]
  checklistTemplateVersions   ChecklistTemplateVersion[]
  checklistSubmissions        ChecklistSubmission[]
  checklistAssignments        ChecklistAssignment[]
  kits                        Kit[]
  dashboardLayouts            DashboardLayout[]
  policyCategories            PolicyCategory[]
  policies                    Policy[]
  policyVersions              PolicyVersion[]
  policyAssignments           PolicyAssignment[]
  policyAcknowledgments       PolicyAcknowledgment[]
  policyTemplates             PolicyTemplate[]
  policyRandomRules           PolicyRandomRule[]
  mapMarkerTypes              MapMarkerType[]
  mapMarkers                  MapMarker[]
  geofences                   Geofence[]
  displayBoards               DisplayBoard[]
  announcements               Announcement[]
  displayEvents               DisplayEvent[]
  properties                  Property[]
  propertyContacts            PropertyContact[]
  prePlans                    PrePlan[]
  inspections                 Inspection[]
}

/// A maintenance request or work record for an apparatus or a piece of equipment.
model MaintenanceRecord {
  id              String    @id @default(cuid())
  tenantId        String
  /// Numbered per department per year, for example MR-2026-0001.
  recordNumber    String
  /// "apparatus" or "equipment".
  assetKind       String    @default("apparatus")
  /// The first linked asset (unit ID or Equipment id), for sorting and search. The full list is in detailsJson.assets.
  assetRef        String    @default("")
  typeId          String?
  description     String    @default("")
  /// Open, Assigned, In Progress, Completed or Cancelled.
  status          String    @default("Open")
  /// Low, Medium, High or Urgent.
  priority        String    @default("Medium")
  dueDate         DateTime? @db.Date
  completedDate   DateTime? @db.Date
  /// "personnel" or "vendor".
  performedByKind String    @default("personnel")
  performedByName String    @default("")
  vendorId        String?
  /// Shown on the display board's apparatus panel while the record is open.
  outOfService    Boolean   @default(false)
  /// Fields still changing: assets, location, location details, attachments.
  detailsJson     Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String    @default("")
  updatedBy       String    @default("")
  deletedAt       DateTime?

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type             MaintenanceType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  costs            MaintenanceCost[]
  partTransactions PartTransaction[]

  @@unique([tenantId, recordNumber])
  @@index([tenantId])
  @@index([tenantId, assetKind, status])
}

/// Maintenance categories. Each department gets its own copy of the NFPA defaults (isSystem) and can add its own.
model MaintenanceType {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  /// "Preventive" or "Corrective".
  category         String    @default("Preventive")
  nfpaStandard     String    @default("")
  defaultFrequency String    @default("")
  description      String    @default("")
  isSystem         Boolean   @default(false)
  enabled          Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String    @default("")
  updatedBy        String    @default("")
  deletedAt        DateTime?

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records     MaintenanceRecord[]
  pmSchedules PmSchedule[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Outside companies that do maintenance work, shared by apparatus and equipment maintenance.
model Vendor {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  contact   String    @default("")
  phone     String    @default("")
  email     String    @default("")
  website   String    @default("")
  services  String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String    @default("")
  updatedBy String    @default("")
  deletedAt DateTime?

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records MaintenanceRecord[]
  costs   MaintenanceCost[]
  parts   Part[]

  @@index([tenantId])
}

/// One cost line on a maintenance record.
model MaintenanceCost {
  id          String    @id @default(cuid())
  tenantId    String
  recordId    String
  description String    @default("")
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  vendorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @default("")
  updatedBy   String    @default("")
  deletedAt   DateTime?

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  record MaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  vendor Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, recordId])
}

/// A recurring preventive maintenance rule.
model PmSchedule {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  typeId    String?
  assetKind String    @default("apparatus")
  assetRef  String    @default("")
  /// Weekly, Monthly, Quarterly, Semi-Annual, Annual or 5 Years. Used when trackingBasis is "date".
  frequency          String    @default("Annual")
  nextDueAt          DateTime? @db.Date
  /// "date", "engineHours", "pumpHours" or "mileage".
  trackingBasis      String    @default("date")
  /// Hours or miles between services, for the reading-based bases.
  intervalValue      Decimal?  @db.Decimal(12, 1)
  /// The reading at the last service. Next due = lastServiceReading + intervalValue.
  lastServiceReading Decimal?  @db.Decimal(12, 1)
  lastServiceDate    DateTime? @db.Date
  /// Warn this many hours, miles or days before due.
  earlyWarning       Decimal?  @db.Decimal(12, 1)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String    @default("")
  updatedBy          String    @default("")
  deletedAt          DateTime?

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type   MaintenanceType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

/// A stocked part. Quantity on hand is the sum of its PartTransaction rows.
model Part {
  id              String    @id @default(cuid())
  tenantId        String
  partNumber      String    @default("")
  description     String    @default("")
  vendorId        String?
  unitCost        Decimal   @default(0) @db.Decimal(12, 2)
  /// Warn when quantity on hand drops to this or below. 0 turns the warning off.
  reorderLevel    Int       @default(0)
  storageLocation String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String    @default("")
  updatedBy       String    @default("")
  deletedAt       DateTime?

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor       Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  transactions PartTransaction[]

  @@index([tenantId])
}

/// Stock movement: received (positive), used on a maintenance record (negative) or adjusted (either).
model PartTransaction {
  id        String    @id @default(cuid())
  tenantId  String
  partId    String
  /// "received", "used" or "adjusted".
  kind      String
  quantity  Int
  unitCost  Decimal   @default(0) @db.Decimal(12, 2)
  recordId  String?
  note      String    @default("")
  createdAt DateTime  @default(now())
  createdBy String    @default("")
  deletedAt DateTime?

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  part   Part               @relation(fields: [partId], references: [id], onDelete: Cascade)
  record MaintenanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, partId])
  @@index([tenantId, recordId])
}

/// A checklist (apparatus inspection now; station checklists in W4). Items live in ChecklistTemplateVersion.
model ChecklistTemplate {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  /// What the checklist is filled out for: "apparatus" for now.
  subjectKind String    @default("apparatus")
  isSystem    Boolean   @default(false)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @default("")
  updatedBy   String    @default("")
  deletedAt   DateTime?

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions    ChecklistTemplateVersion[]
  submissions ChecklistSubmission[]
  assignments ChecklistAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A frozen copy of a template's sections and items, so old submissions keep the wording they were filled with.
model ChecklistTemplateVersion {
  id         String   @id @default(cuid())
  tenantId   String
  templateId String
  version    Int
  /// [{ id, title, items: [{ id, label }] }]
  itemsJson  Json     @default("[]")
  createdAt  DateTime @default(now())
  createdBy  String   @default("")

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template    ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissions ChecklistSubmission[]
  inspections Inspection[]

  @@unique([templateId, version])
  @@index([tenantId])
}

/// One completed checklist, for example an apparatus inspection.
model ChecklistSubmission {
  id                String    @id @default(cuid())
  tenantId          String
  /// Numbered per department per year, for example INS-26-0001.
  submissionNumber  String
  templateId        String
  templateVersionId String
  subjectKind       String    @default("apparatus")
  /// The unit ID for apparatus.
  subjectRef        String    @default("")
  completedOn       DateTime  @db.Date
  completedByName   String    @default("")
  /// "Submitted" for now.
  status            String    @default("Submitted")
  repairCount       Int       @default(0)
  /// { [itemId]: { result, note, recordId } }
  resultsJson       Json      @default("{}")
  /// Inspection header fields still changing: officer, station, readings, comments.
  detailsJson       Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String    @default("")
  updatedBy         String    @default("")
  deletedAt         DateTime?

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template        ChecklistTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion ChecklistTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, submissionNumber])
  @@index([tenantId])
  @@index([tenantId, subjectKind, subjectRef])
}

/// Who checks what with a checklist template, and how often.
model ChecklistAssignment {
  id              String    @id @default(cuid())
  tenantId        String
  templateId      String
  /// apparatus, station, kit or none
  targetKind      String    @default("none")
  /// Unit ID, station name or Kit id. Empty when targetKind is none.
  targetRef       String    @default("")
  /// Personnel name, or empty for anyone.
  assignedTo      String    @default("")
  /// once, shift, daily, weekly or monthly
  frequency       String    @default("daily")
  startsOn        DateTime  @db.Date
  active          Boolean   @default(true)
  lastCompletedOn DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String    @default("")
  updatedBy       String    @default("")
  deletedAt       DateTime?

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

/// A bag or box that is checked as a unit, for example a jump bag or an RIT pack.
model Kit {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  kitType     String    @default("")
  /// The unit or station the kit is kept on, as a name.
  locationRef String    @default("")
  /// Notes and other fields that are still changing.
  detailsJson Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @default("")
  updatedBy   String    @default("")
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Dashboard widget layout. One row per user, plus one department default (userId "").
model DashboardLayout {
  id         String    @id @default(cuid())
  tenantId   String
  /// TenantUser id, or empty for the department default.
  userId     String    @default("")
  /// { items: [{ i, x, y, w, h }] } on a 12-column grid.
  layoutJson Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String    @default("")
  updatedBy  String    @default("")
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Numbered chapter of the policy manual, or a DTB category.
model PolicyCategory {
  id        String    @id @default(cuid())
  tenantId  String
  /// manual or dtb
  kind      String    @default("manual")
  /// Chapter number. 0 is the Preface.
  number    Int       @default(0)
  title     String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String    @default("")
  updatedBy String    @default("")
  deletedAt DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policies Policy[]

  @@index([tenantId])
}

/// A policy or Daily Training Bulletin. Published wording lives in PolicyVersion; the unpublished draft in draftJson.
model Policy {
  id             String    @id @default(cuid())
  tenantId       String
  categoryId     String?
  /// policy or dtb
  kind           String    @default("policy")
  /// Policy number as shown, for example "201".
  number         String    @default("")
  title          String
  /// draft, published or archived
  status         String    @default("draft")
  /// { content, attachment } not yet published.
  draftJson      Json      @default("{}")
  currentVersion Int       @default(0)
  /// The newest version members must acknowledge. A minor republish keeps the old number.
  ackVersion     Int       @default(0)
  publishedAt    DateTime?
  effectiveDate  DateTime? @db.Date
  requiresAck    Boolean   @default(true)
  sortOrder      Int       @default(0)
  detailsJson    Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String    @default("")
  updatedBy      String    @default("")
  deletedAt      DateTime?

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        PolicyCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions        PolicyVersion[]
  assignments     PolicyAssignment[]
  acknowledgments PolicyAcknowledgment[]

  @@index([tenantId])
  @@index([tenantId, categoryId])
}

/// One published wording of a policy. Never edited after publishing.
model PolicyVersion {
  id             String   @id @default(cuid())
  tenantId       String
  policyId       String
  version        Int
  /// Editor document (TipTap JSON).
  contentJson    Json     @default("{}")
  /// Plain text of the document, for search.
  contentText    String   @default("")
  /// Uploaded PDF { name, size, dataUrl } until file storage exists.
  attachmentJson Json     @default("{}")
  requireReack   Boolean  @default(true)
  changeNote     String   @default("")
  publishedAt    DateTime @default(now())
  publishedBy    String   @default("")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([tenantId])
}

/// Who must acknowledge a policy. userId "" means everyone in the department.
model PolicyAssignment {
  id         String    @id @default(cuid())
  tenantId   String
  policyId   String
  userId     String    @default("")
  /// publish, manual, template or rule
  source     String    @default("manual")
  templateId String?
  ruleId     String?
  /// Week or month a random rule picked this for, for example 2026-W48 or 2026-11.
  periodKey  String    @default("")
  dueDate    DateTime? @db.Date
  assignedBy String    @default("")
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, policyId])
}

/// Add-only record that a member acknowledged a policy version.
model PolicyAcknowledgment {
  id             String   @id @default(cuid())
  tenantId       String
  policyId       String
  version        Int
  userId         String
  userName       String   @default("")
  acknowledgedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, policyId, version, userId])
  @@index([tenantId, userId])
}

/// A named bundle of policies assigned together, for example "Rookie Policies".
model PolicyTemplate {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  policyIds Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String    @default("")
  updatedBy String    @default("")
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Assigns a number of random published policies or DTBs each week or month.
model PolicyRandomRule {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  /// policy or dtb
  kind        String    @default("dtb")
  count       Int       @default(1)
  /// week or month
  period      String    @default("week")
  categoryIds Json      @default("[]")
  /// User ids. Empty means everyone.
  userIds     Json      @default("[]")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @default("")
  updatedBy   String    @default("")
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Equipment registry (SCBA, hose, ladders, extinguishers and so on).
model Equipment {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  equipmentType String    @default("")
  serialNumber  String    @default("")
  /// The unit or station the equipment is kept on, as a name until apparatus and stations get real tables.
  locationRef   String    @default("")
  /// In Service, Out of Service or Retired.
  status        String    @default("In Service")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String    @default("")
  updatedBy     String    @default("")
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A note on any record in the operations modules (maintenance, inspections, policies and so on).
model Comment {
  id           String    @id @default(cuid())
  tenantId     String
  /// Which kind of record this note belongs to, for example "maintenanceRecord" or "inspection".
  ownerType    String
  ownerId      String
  body         String
  authorUserId String?
  authorName   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerType, ownerId])
}

/// Icon and color for a kind of map marker (hydrant, Knox box, hazard, and so on).
model MapMarkerType {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  /// hydrant, fdc, knox, hazard, firehouse, preplan, landing, shutoff, standpipe, donotenter, marker
  icon      String    @default("marker")
  color     String    @default("#16a34a")
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String    @default("")
  updatedBy String    @default("")
  deletedAt DateTime?

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  markers MapMarker[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A point the department placed itself. The coordinates are the pin someone dropped, not a stored Google result.
model MapMarker {
  id           String    @id @default(cuid())
  tenantId     String
  markerTypeId String?
  latitude     Float
  longitude    Float
  label        String    @default("")
  /// notes, address, flowGpm, documents
  detailsJson  Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String    @default("")
  updatedBy    String    @default("")
  deletedAt    DateTime?

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  markerType MapMarkerType? @relation(fields: [markerTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, markerTypeId])
}

/// A department-drawn area. geometryJson is GeoJSON the department drew (Terra Draw), not a Google shape.
model Geofence {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  description      String    @default("")
  /// district, station, subsection, mutualAid, hazard, custom
  kind             String    @default("custom")
  color            String    @default("#dc2626")
  parentId         String?
  geometryJson     Json
  linkedPropertyId String    @default("")
  linkedPrePlanId  String    @default("")
  /// documents and other fields that are still changing
  detailsJson      Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String    @default("")
  updatedBy        String    @default("")
  deletedAt        DateTime?

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Geofence?  @relation("GeofenceTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Geofence[] @relation("GeofenceTree")

  @@index([tenantId])
  @@index([tenantId, kind])
}

/// A station TV board. The page is /display/:id; it reads calls, crews and apparatus status, and writes nothing.
model DisplayBoard {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  stationName       String    @default("")
  /// all or districts
  callFilter        String    @default("all")
  filterGeofenceIds String[]  @default([])
  takeoverSeconds   Int       @default(60)
  soundOn           Boolean   @default(true)
  /// { panels: { apparatus, onDuty, incidents, events, messages } }
  layoutJson        Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String    @default("")
  updatedBy         String    @default("")
  deletedAt         DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A message shown on every board of the department. Important ones scroll in the red banner.
model Announcement {
  id        String    @id @default(cuid())
  tenantId  String
  title     String
  body      String    @default("")
  important Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String    @default("")
  updatedBy String    @default("")
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// An upcoming event on the boards until the Calendar module replaces it.
model DisplayEvent {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  startsAt    DateTime
  /// location, notes
  detailsJson Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @default("")
  updatedBy   String    @default("")
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, startsAt])
}

/// A building or address the department pre-plans and inspects. The pin is the one a member placed, not a stored Google result.
model Property {
  id                String    @id @default(cuid())
  tenantId          String
  /// Occupant or business name, for example "Meadowview Theatre". Optional.
  name              String    @default("")
  address           String
  /// Suite, unit or lot.
  unit              String    @default("")
  city              String    @default("")
  state             String    @default("")
  postalCode        String    @default("")
  /// Server-made cleaned street address ("401 MAPLE ST") for call history, the NERIS picker and duplicate warnings.
  normalizedAddress String    @default("")
  /// residential or commercial
  propertyType      String    @default("residential")
  occupancyType     String    @default("")
  squareFeet        Int?
  yearBuilt         Int?
  latitude          Float?
  longitude         Float?
  /// Street View camera position only; the picture always loads live from Google.
  streetViewPanoId  String    @default("")
  streetViewHeading Float?
  streetViewPitch   Float?
  streetViewZoom    Float?
  /// Department photo. A small data URL for the demo, a storage key once R2 exists. Lists never load it.
  photoRef          String    @default("")
  /// notes and fields that are still changing
  detailsJson       Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String    @default("")
  updatedBy         String    @default("")
  deletedAt         DateTime?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts    PropertyContact[]
  prePlans    PrePlan[]
  inspections Inspection[]

  @@index([tenantId])
  @@index([tenantId, normalizedAddress])
  @@index([tenantId, propertyType])
}

/// A person tied to a property: owner, tenant, manager and so on.
model PropertyContact {
  id            String    @id @default(cuid())
  tenantId      String
  propertyId    String
  firstName     String    @default("")
  lastName      String    @default("")
  businessName  String    @default("")
  /// Owner, Tenant, Building Maintenance, Manager, Secondary Contact, Other, or empty for no role.
  role          String    @default("")
  isPrimary     Boolean   @default(false)
  phone         String    @default("")
  email         String    @default("")
  /// Mailing address; empty means the same as the property.
  addressStreet String    @default("")
  addressUnit   String    @default("")
  addressCity   String    @default("")
  addressState  String    @default("")
  addressZip    String    @default("")
  /// notes and fields that are still changing
  detailsJson   Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String    @default("")
  updatedBy     String    @default("")
  deletedAt     DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, propertyId])
}

/// A pre-plan for a property. Every field is optional and lives in detailsJson.
model PrePlan {
  id          String    @id @default(cuid())
  tenantId    String
  propertyId  String
  /// basic or complex
  template    String    @default("basic")
  title       String    @default("Pre-Plan")
  reviewedOn  DateTime? @db.Date
  detailsJson Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @default("")
  updatedBy   String    @default("")
  deletedAt   DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, propertyId])
}

/// A fire prevention inspection of a property. Apparatus inspections stay in ChecklistSubmission.
model Inspection {
  id                String    @id @default(cuid())
  tenantId          String
  /// Numbered per department per year, for example FPI-26-0001.
  inspectionNumber  String
  propertyId        String
  inspectionType    String    @default("")
  isReinspection    Boolean   @default(false)
  reinspectionOfId  String?
  receivedOn        DateTime? @db.Date
  /// Plain date and 24-hour "HH:MM" so the calendar never shifts a day for time zones.
  scheduledOn       DateTime? @db.Date
  scheduledTime     String    @default("")
  /// Scheduled, In Progress, Passed, Failed, Pending Reinspection or Cancelled
  status            String    @default("Scheduled")
  leadInspector     String    @default("")
  /// ["name", ...]
  otherInspectors   Json      @default("[]")
  reason            String    @default("")
  district          String    @default("")
  division          String    @default("")
  station           String    @default("")
  shift             String    @default("")
  unit              String    @default("")
  templateVersionId String?
  completedOn       DateTime? @db.Date
  resultsJson       Json      @default("{}")
  detailsJson       Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String    @default("")
  updatedBy         String    @default("")
  deletedAt         DateTime?

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property        Property                  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  templateVersion ChecklistTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, inspectionNumber])
  @@index([tenantId])
  @@index([tenantId, propertyId])
  @@index([tenantId, scheduledOn])
  @@index([tenantId, status])
}

/// One row per shift trade request. Names match Scheduler Settings → Personnel; usernames decide who may see and act on it.
model TradeRequest {
  id                  String   @id @default(cuid())
  tenantId            String
  shiftType           String   @default("")
  requesterUsername   String
  requesterName       String
  counterpartUsername String
  counterpartName     String
  tradeDate           String
  startTime           String
  endTime             String
  paybackRequired     Boolean  @default(false)
  paybackDate         String   @default("")
  reason              String   @default("")
  status              String   @default("requested")
  denialReason        String   @default("")
  /// What accepting the trade changed on the schedule, so a cancelled trade can be put back.
  scheduleChangeJson  Json?
  /// Who did what and when: [{ at, by, action, note }].
  historyJson         Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, requesterUsername])
  @@index([tenantId, counterpartUsername])
}

/// One request to let a lower qualification fill a seat until a sub admin approves it.
model QualificationOverrideRequest {
  id                    String   @id @default(cuid())
  tenantId              String
  requesterUsername     String
  requesterName         String
  personName            String
  shiftType             String   @default("")
  apparatus             String   @default("")
  unitId                String   @default("")
  slotIndex             Int      @default(0)
  dateKey               String
  requiredQualification String   @default("")
  status                String   @default("pending")
  denialReason          String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// One row per incident call number per tenant: Fire Recovery billing submit + cached billing status.
model FireRecoveryIncidentBilling {
  id                    String    @id @default(cuid())
  tenantId              String
  callNumber            String
  trackingId            String?
  lastSubmitAt          DateTime?
  lastSubmitOk          Boolean   @default(false)
  lastSubmitError       String    @default("")
  submitStatus          String    @default("")
  submitStartedAt       DateTime?
  incidentType          String    @default("")
  incidentDateLabel     String    @default("")
  invoiceId             String    @default("")
  invoiceAmount         String    @default("")
  invoiceAmountDue      String    @default("")
  invoiceSubmitDate     String    @default("")
  invoiceStatus         String    @default("")
  lastPaymentDate       String    @default("")
  lastPaymentAmount     String    @default("")
  paymentPlan           Boolean   @default(false)
  billingFetchedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, callNumber])
  @@index([tenantId])
  @@index([tenantId, updatedAt])
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  hostname  String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  username     String
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([tenantId, username])
  @@index([tenantId])
}

/// Sign-in sheet. One row per login. The browser holds the pass; this table holds only its fingerprint.
model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  tenantId     String
  userId       String
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

/// One row per department per action: the lowest role allowed to do that action.
model RolePermission {
  id          String   @id @default(cuid())
  tenantId    String
  permission  String
  minimumRole String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, permission])
  @@index([tenantId])
}

/// Who changed an account, and what changed. Never stores a password.
model AccountAuditLog {
  id             String   @id @default(cuid())
  tenantId       String
  actorUserId    String?
  actorUsername  String
  action         String
  targetUsername String
  detail         String   @default("")
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model DepartmentDetails {
  id             String   @id @default(cuid())
  tenantId       String
  departmentName String?
  payloadJson    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@index([tenantId])
}

model ScheduleAssignments {
  id              String   @id @default(cuid())
  tenantId        String
  shiftType       String
  dateKey         String
  assignmentsJson Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, shiftType, dateKey])
  @@index([tenantId])
}

model Incident {
  id             String    @id @default(cuid())
  tenantId       String
  incidentNumber String?
  dispatchNumber String?
  incidentType   String    @default("")
  priority       String    @default("")
  address        String    @default("")
  stillDistrict  String    @default("")
  assignedUnits  String    @default("")
  reportedBy     String?
  callbackNumber String?
  dispatchNotes  String?
  currentState   String    @default("Draft")
  receivedAt     String    @default("")
  dispatchInfo   String    @default("")
  apparatusJson  Json?
  mapReference   String?
  /// Map point for the call address. A cache, cleared after 30 days; it is never part of the NERIS report.
  latitude       Float?
  longitude      Float?
  geocodedAt     DateTime?
  deletedAt      DateTime?
  deletedBy      String?
  deletedReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model CadEmailIngest {
  id                 String   @id @default(cuid())
  tenantId           String?
  fromAddress        String   @default("")
  toAddress          String   @default("")
  rawBody            String   @default("")
  headersJson        Json?
  /// Output of message rules at ingest (Batch H); empty if no rules / failure.
  parsedMessageText  String   @default("")
  createdAt          DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
}

/// Per-tenant CAD dispatch parsing config (message + incident rule JSON; Batch C+).
model CadParsingSettings {
  id                         String   @id @default(cuid())
  tenantId                   String   @unique
  enableIncidentCreation     Boolean  @default(false)
  enableIncidentUpdate       Boolean  @default(false)
  messageRulesJson           Json     @default("[]")
  incidentRulesJson          Json     @default("[]")
  incidentFieldMapJson       Json     @default("{}")
  incidentNumberExtractJson  Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Per-tenant allowed sender patterns for CAD email (enforced in Batch D).
model CadEmailAllowlistEntry {
  id          String   @id @default(cuid())
  tenantId    String
  pattern     String
  patternType String   @default("domain_suffix")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, enabled])
}

model NerisExportHistory {
  id                       String   @id @default(cuid())
  tenantId                 String
  callNumber               String   @default("")
  incidentType             String   @default("")
  address                  String   @default("")
  exportedAtIso            String   @default("")
  exportedAtLabel          String   @default("")
  attemptStatus            String   @default("success")
  httpStatus               Int      @default(200)
  httpStatusText           String   @default("")
  statusLabel              String   @default("")
  reportStatusAtExport     String   @default("")
  validatorName            String   @default("")
  reportWriterName         String   @default("")
  submittedEntityId        String   @default("")
  submittedDepartmentNerisId String @default("")
  nerisId                  String   @default("")
  responseSummary          String   @default("")
  responseDetail           String   @default("")
  submittedPayloadPreview  String   @default("")
  createdAt                DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model NerisDraft {
  id         String   @id @default(cuid())
  tenantId   String
  callNumber String
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, callNumber])
  @@index([tenantId])
}

/// Who saved a NERIS report, and which field names changed. Add-only. No old or new text.
model NerisReportChange {
  id            String   @id @default(cuid())
  tenantId      String
  callNumber    String
  actorUserId   String?
  actorUsername String
  fieldNames    Json
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, callNumber, createdAt])
}